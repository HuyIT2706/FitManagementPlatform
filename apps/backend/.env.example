# ====================================================================
# NutriCore Backend Environment Variables
# ====================================================================

PORT=3100
NODE_ENV=development

# Allowed Frontend Origins (comma-separated if multiple, e.g. http://localhost:3000,https://yourdomain.com)
CLIENT_URL=http://localhost:3000

# PostgreSQL Database URL
DATABASE_URL="postgresql://user:password@localhost:5432/fit_management_db?schema=public"

# JWT Secret for access and refresh tokens
JWT_SECRET=your-secure-jwt-secret-key-at-least-32-chars

# Google OAuth Credentials (for backend ID token verification)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Web Push Notification VAPID Keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:support@nutricore.vn
