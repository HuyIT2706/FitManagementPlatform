# ====================================================================
# NutriCore Web (Frontend) Environment Variables
# ====================================================================

# Backend API Base URL
# - Local development: http://localhost:3100
# - Production: https://your-backend-domain.com
NEXT_PUBLIC_API_URL=http://localhost:3100

# Google OAuth Client ID (from Google Cloud Console)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# AES-256-GCM Payload Encryption Key (must match backend API_ENCRYPTION_KEY)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXT_PUBLIC_API_ENCRYPTION_KEY=your-64-char-hex-encryption-key
