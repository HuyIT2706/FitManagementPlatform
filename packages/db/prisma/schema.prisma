datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ======================================================
// ENUMS
// ======================================================
enum Role {
  ADMIN
  PT
  USER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ActivityLevel {
  SEDENTARY         // Ít hoặc không vận động (VP, ngồi nhiều)
  LIGHTLY_ACTIVE    // Vận động nhẹ (Tập 1-3 buổi/tuần)
  MODERATELY_ACTIVE // Vận động vừa (Tập 3-5 buổi/tuần)
  VERY_ACTIVE       // Vận động nhiều (Tập 6-7 buổi/tuần)
  EXTRA_ACTIVE      // Vận động rất nặng (VĐV, lao động chân tay nặng)
}

enum AttendanceStatus {
  CHECKED_IN
  CANCELLED
}

enum ExerciseCategory {
  CHEST
  BACK
  LEGS
  SHOULDERS
  ARMS
  ABS
  CARDIO
  FULL_BODY
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  fullName      String
  phone         String?
  avatarUrl     String?
  gender        Gender?        // Giới tính
  dateOfBirth   DateTime?      // Ngày sinh (dùng để tính Tuổi chuẩn xác)
  activityLevel ActivityLevel? // Mức độ vận động
  role          Role           @default(USER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  trainerProfiles StudentProfile[] @relation("TrainerRelation")
  studentProfiles StudentProfile[] @relation("StudentRelation")

  userPackages MemberPackage[]
  attendances  AttendanceHistory[] @relation("StudentAttendance")

  nutritionTargets NutritionTarget[]
  workoutSchedules WorkoutSchedule[]

  mealLogs       MealLog[]
  trainerReviews MealReview[]    @relation("TrainerReviews")

  bodyMetrics    BodyMetric[]
  progressPhotos ProgressPhoto[]

  @@map("users")
}

model StudentProfile {
  id         String   @id @default(uuid())
  trainerId  String
  studentId  String
  assignedAt DateTime @default(now())

  trainer User @relation("TrainerRelation", fields: [trainerId], references: [id], onDelete: Cascade)
  student User @relation("StudentRelation", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([trainerId, studentId])
  @@map("student_profiles")
}

model GymPackage {
  id            String   @id @default(uuid())
  title         String
  description   String?
  price         Float
  totalSessions Int
  durationDays  Int
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  memberPackages MemberPackage[]

  @@map("gym_packages")
}

model MemberPackage {
  id                String   @id @default(uuid())
  userId            String
  packageId         String
  totalSessions     Int
  remainingSessions Int
  startDate         DateTime @default(now())
  endDate           DateTime
  isActive          Boolean  @default(true)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  gymPackage  GymPackage  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  attendances AttendanceHistory[]

  @@map("member_packages")
}

model AttendanceHistory {
  id              String           @id @default(uuid())
  memberPackageId String
  studentId       String
  checkInTime     DateTime         @default(now())
  status          AttendanceStatus @default(CHECKED_IN)
  note            String?

  memberPackage MemberPackage @relation(fields: [memberPackageId], references: [id], onDelete: Cascade)
  student       User          @relation("StudentAttendance", fields: [studentId], references: [id], onDelete: Cascade)

  @@map("attendance_histories")
}

model NutritionTarget {
  id            String   @id @default(uuid())
  studentId     String
  targetCalo    Float
  targetProtein Float
  targetCarbs   Float
  targetFat     Float
  effectiveDate DateTime @default(now())

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("nutrition_targets")
}

model WorkoutSchedule {
  id            String   @id @default(uuid())
  studentId     String
  title         String
  scheduledDate DateTime
  isCompleted   Boolean  @default(false)
  note          String?

  student   User               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  exercises ScheduleExercise[]

  @@map("workout_schedules")
}

model ScheduleExercise {
  id                String  @id @default(uuid())
  workoutScheduleId String
  exerciseLibraryId String
  sets              Int
  reps              Int
  weight            Float?

  schedule WorkoutSchedule @relation(fields: [workoutScheduleId], references: [id], onDelete: Cascade)
  exercise ExerciseLibrary @relation(fields: [exerciseLibraryId], references: [id], onDelete: Cascade)

  @@map("schedule_exercises")
}

model MealLog {
  id        String   @id @default(uuid())
  userId    String
  logDate   DateTime @default(now())
  mealName  String
  
  totalCalories Float @default(0)
  totalProtein  Float @default(0)
  totalCarbs    Float @default(0)
  totalFat      Float @default(0)

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items   MealItem[]
  reviews MealReview[]

  @@map("meal_logs")
}

model MealItem {
  id            String  @id @default(uuid())
  mealLogId     String
  foodLibraryId String?
  foodName      String
  weightInGram  Float
  calories      Float
  protein       Float
  carbs         Float
  fat           Float

  mealLog MealLog      @relation(fields: [mealLogId], references: [id], onDelete: Cascade)
  food    FoodLibrary? @relation(fields: [foodLibraryId], references: [id], onDelete: SetNull)

  @@map("meal_items")
}

model MealReview {
  id        String   @id @default(uuid())
  mealLogId String
  ptId      String
  comment   String
  createdAt DateTime @default(now())

  mealLog MealLog @relation(fields: [mealLogId], references: [id], onDelete: Cascade)
  pt      User    @relation("TrainerReviews", fields: [ptId], references: [id], onDelete: Cascade)

  @@map("meal_reviews")
}

model BodyMetric {
  id         String   @id @default(uuid())
  userId     String
  weight     Float
  height     Float?
  bodyFat    Float?
  muscleMass Float?
  recordedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("body_metrics")
}

model ProgressPhoto {
  id       String   @id @default(uuid())
  userId   String
  photoUrl String
  tag      String?
  takenAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("progress_photos")
}

model ExerciseLibrary {
  id          String           @id @default(uuid())
  name        String
  category    ExerciseCategory
  videoUrl    String?
  description String?

  scheduleExercises ScheduleExercise[]

  @@map("exercise_libraries")
}

model FoodLibrary {
  id              String @id @default(uuid())
  name            String
  caloriesPer100g Float
  proteinPer100g  Float
  carbsPer100g    Float
  fatPer100g      Float

  mealItems MealItem[]

  @@map("food_libraries")
}
